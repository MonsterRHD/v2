+++	if err != nil || (parsed.Scheme != "postgres" && parsed.Scheme != "postgresql") {
+++		t.Fatalf("%s must be a postgres:// URL, got %q", testDatabaseURLEnvVar, dsn)
+++	}
+++
+++	const databaseName = "miniflux_test_websession_ui"
+++
+++	adminURL := *parsed
+++	adminURL.Path = "/postgres"
