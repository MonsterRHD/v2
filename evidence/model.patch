++// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
++// SPDX-License-Identifier: Apache-2.0
++
++package webhook // import "miniflux.app/v2/internal/integration/webhook"
++
++import (
++	"context"
++	"errors"
++	"fmt"
++	"log/slog"
++	"sync"
