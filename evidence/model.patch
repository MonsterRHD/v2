+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	go d.Run(ctx)
+
+	// Wait for the startup sweep to settle, then enqueue and notify.
+	time.Sleep(50 * time.Millisecond)
+	store.addDelivery(pendingDelivery(1, remote.URL, 3))
