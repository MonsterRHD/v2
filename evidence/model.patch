++++	if cookie != "" {
++++		req.Header.Set("Cookie", sessionCookieName+"="+cookie)
++++	}
++++
++++	recorder := httptest.NewRecorder()
++++	handler.ServeHTTP(recorder, req)
++++
++++	return recorder, &handlerCalls
++++}
