++++	}
++++	assertCounts(t, final, map[string]int{
++++		model.OPMLImportItemStatusCreated: 2,
++++	})
++++	if !fake.hasFetched(secondURL) {
++++		t.Error("the remaining item should be fetched on explicit continue")
