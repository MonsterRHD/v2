++func batchOutline(feedURL string, extra ...string) string {
++	attributes := ""
++	if len(extra) > 0 {
++		attributes = " " + extra[0]
++	}
++	return fmt.Sprintf(`<outline type="rss" title="%[1]s" xmlUrl="%[1]s" htmlUrl="%[1]s"%[2]s/>`, feedURL, attributes)
++}
