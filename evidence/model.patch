++++	db, err := sql.Open("postgres", dsn)
++++	if err != nil {
++++		t.Skipf("unable to open test database: %v", err)
++++	}
++++
++++	if err := db.Ping(); err != nil {
++++		db.Close()
++++		t.Skipf("test database is not available: %v", err)
