+		t.Fatalf("Expected exactly one distinct event id across attempts, got %v", seenEventIDs)
+	}
+
+	if _, ok := seenEventIDs[eventID]; !ok {
+		t.Fatalf("Expected event id %q to be the only one seen, got %v", eventID, seenEventIDs)
+	}
+}
