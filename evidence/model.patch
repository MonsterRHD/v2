++++		if status == http.StatusTooManyRequests || status == http.StatusServiceUnavailable {
++++			w.Header().Set("Retry-After", "30")
++++		}
++++
++++		w.WriteHeader(status)
++++
++++		if status >= 400 {
++++			_, _ = w.Write([]byte("remote failure body"))
++++		}
++++	}))
++++	t.Cleanup(remote.Close)
++++
++++	return remote
++++}
