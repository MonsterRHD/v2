+++			// emitted while the connection was down were missed, so resync.
+++			if notification == nil {
+++				if _, err := m.Refresh(ctx); err != nil {
+++					slog.Warn("Unable to resync web session generation after listener reconnect", slog.Any("error", err))
+++				}
+++				continue
+++			}
