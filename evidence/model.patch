+++		t.Fatalf("baseline FlushAllSessions() error: %v", err)
+++	}
+++
+++	const (
+++		creatorCount = 8
+++		flushCount   = 25
+++	)
+++
+++	var wg sync.WaitGroup
+++	stop := make(chan struct{})
+++	var creatorFailures atomic.Int64
+++
+++	for range creatorCount {
+++		wg.Add(1)
+++		go func() {
+++			defer wg.Done()
+++			for {
+++				select {
+++				case <-stop:
+++					return
