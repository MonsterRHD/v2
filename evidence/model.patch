+	store.entries[1] = dispatcherEntry(1)
+
+	d := &Dispatcher{
+		store:             store,
+		pollInterval:      time.Hour,
+		lease:             2 * time.Minute,
+		initialBackoff:    10 * time.Second,
+		maxBackoff:        80 * time.Second,
+		backoffMultiplier: 2,
+		batchSize:         4,
+		clock:             clock,
+		kick:              make(chan struct{}, 1),
+	}
