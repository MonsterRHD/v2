+
+	for range creatorCount {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+
+				session, _ := model.NewWebSession("concurrent", "")
