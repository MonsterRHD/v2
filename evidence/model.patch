+++	m.mu.Lock()
+++	defer m.mu.Unlock()
+++
+++	if !m.loaded || generation > m.generation {
+++		m.generation = generation
+++	}
+++	m.fetchedAt = time.Now()
+++	m.loaded = true
+++}
