++
++	// Force it back to in_flight and record the terminal success.
++	if _, err := db.Exec(`UPDATE webhook_save_deliveries SET status = 'in_flight' WHERE id = $1`, delivery.ID); err != nil {
++		t.Fatalf("Unable to force in_flight: %v", err)
