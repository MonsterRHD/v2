diff --git a/evidence/verify_rubric.yaml b/evidence/verify_rubric.yaml
new file mode 100644
index 00000000..de33247a
--- /dev/null
+++ b/evidence/verify_rubric.yaml
@@ -0,0 +1,25 @@
+rubrics:
+  - id: 1
+    type: f2p
+    text: "首次导入先冻结分类与订阅计划并返回稳定导入标识，格式错误不会留下半个可运行批次。"
+  - id: 2
+    type: f2p
+    text: "每个计划项记录创建、合并、临时失败或永久失败，状态可查询且与数据库结果对应。"
+  - id: 3
+    type: f2p
+    text: "同一 OPML 重复提交或同一批次重试不会复制 feed、category，也不会重新处理已成功项。"
+  - id: 4
+    type: f2p
+    text: "进程在任意项后重启可从持久进度继续；临时抓取失败可显式恢复而不重做成功项。"
+  - id: 5
+    type: f2p
+    text: "取消批次后不再启动新抓取，已提交项目保留，晚到结果按取消边界确定归属。"
+  - id: 6
+    type: f2p
+    text: "永久失败项可在修正后按原计划位置重试，并保留其他项目的结果和顺序。"
+  - id: 7
+    type: p2p
+    text: "现有小型同步导入调用和 OPML 导出格式保持兼容。"
+  - id: 8
+    type: f2p
+    text: "完成、部分失败或取消后的汇总数量与实际分类、订阅及失败项逐项一致。"
diff --git a/internal/api/api.go b/internal/api/api.go
index 3cf8f75d..0b61dfa8 100644
--- a/internal/api/api.go
+++ b/internal/api/api.go
@@ -51,6 +51,12 @@ func NewHandler(store *storage.Storage, pool *worker.Pool) http.Handler {
 	mux.HandleFunc("PUT /v1/feeds/{feedID}/mark-all-as-read", handler.markFeedAsReadHandler)
 	mux.HandleFunc("GET /v1/export", handler.exportFeedsHandler)
 	mux.HandleFunc("POST /v1/import", handler.importFeedsHandler)
+	mux.HandleFunc("POST /v1/opml/imports", handler.createOPMLImportHandler)
+	mux.HandleFunc("GET /v1/opml/imports", handler.getOPMLImportsHandler)
+	mux.HandleFunc("GET /v1/opml/imports/{importID}", handler.getOPMLImportHandler)
+	mux.HandleFunc("POST /v1/opml/imports/{importID}/continue", handler.continueOPMLImportHandler)
+	mux.HandleFunc("POST /v1/opml/imports/{importID}/cancel", handler.cancelOPMLImportHandler)
+	mux.HandleFunc("POST /v1/opml/imports/{importID}/items/{itemID}/retry", handler.retryOPMLImportItemHandler)
