+++func uniqueTestUsername(prefix string) string {
+++	return prefix + "_" + strings.ReplaceAll(time.Now().Format("150405.000000"), ".", "") + "_" +
+++		strconv.FormatInt(testUserSerial.Add(1), 10)
+++}
