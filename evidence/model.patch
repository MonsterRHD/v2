++++func recordExists(db *sql.DB, id int64) (bool, error) {
++++	var count int
++++	if err := db.QueryRow(`SELECT count(*) FROM webhook_save_deliveries WHERE id = $1`, id).Scan(&count); err != nil {
++++		return false, err
++++	}
++++
++++	return count == 1, nil
++++}
