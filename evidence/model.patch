++++		idx := int(atomic.AddInt64(&remote.requests, 1)) - 1
++++		remote.eventIDs = append(remote.eventIDs, r.Header.Get(EventIDHeader))
++++
++++		status := http.StatusOK
++++		if idx < len(remote.statuses) {
