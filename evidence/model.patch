++		Settings:     correction.Settings,
++	})
++	if err != nil {
++		return nil, err
++	}
++
++	started, err := h.store.TryStartOPMLImport(userID, importID, true)
++	if err != nil {
++		return nil, err
++	}
++
++	if started && h.autoStart {
++		go h.runImport(context.Background(), userID, importID, item.ID)
++	}
