++// webhookDeliveryColumns lists the persisted columns of a delivery record, in
++// the exact scan order expected by scanWebhookDelivery.
++const webhookDeliveryColumns = `
++	id,
++	event_id,
++	user_id,
++	entry_id,
++	webhook_url,
++	status,
++	attempts,
